# Configuracion local del backend. Copie este archivo como .env y complete los valores.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Origenes permitidos, separados por coma: el frontend local y el publicado en GitHub Pages
FRONTEND_ORIGIN=http://localhost:5173,https://miguelperez80.github.io

# Oracle (usuario dueno del esquema, creado en USUARIOS.sql)
DB_USER=itecci
DB_PASSWORD="su-clave-de-oracle"
DB_CONNECT_STRING=localhost:1521/freepdb1

# Sesion
JWT_SECRET=cambie-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_MIN=120